# Backend environment configuration

# Database (pooled connection string)
DATABASE_URL=

# Direct/unpooled connection for migrations (optional)
DATABASE_URL_UNPOOLED=

# JWT/session signing secret (minimum 16 chars)
JWT_SECRET=

# SMTP settings for verification/reset emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Demo fallback: only enable for local demo when SMTP is unavailable
DEMO_MODE=false

# LLM / advisor configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADVISOR_MODEL=gpt-4o-mini
APP_CONTROL_MODEL=

# Weather provider
OPENWEATHER_API_KEY=

# Embeddings / knowledge tooling
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Price ingestion and cron protection
PRICES_CRON_SECRET=
CRON_SECRET=
PEST_CRON_SECRET=

# Weather alert trigger protection
ADVISOR_CRON_SECRET=

# Detect model (optional)
DETECT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Optional app URL for generated links
NEXT_PUBLIC_APP_URL=http://localhost:3000
