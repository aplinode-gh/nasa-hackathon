# Backend environment configuration

# Database (pooled connection string)
DATABASE_URL=

# Direct/unpooled connection for migrations (optional)
DATABASE_URL_UNPOOLED=

# JWT/session signing secret (minimum 16 chars)
JWT_SECRET=

# SMTP settings for verification/reset emails
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=

# Demo fallback: only enable for local demo when SMTP is unavailable
DEMO_MODE=false

# CORS (comma-separated origins). Frontend dev server is allowed by default.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# LLM / advisor configuration
# Use LLM_* to point every feature at your own OpenAI-compatible model server.
# OPENAI_* and ADVISOR_MODEL remain supported as fallbacks.
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ADVISOR_MODEL=gpt-4o-mini
APP_CONTROL_MODEL=
SUMMARY_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=

# Weather provider
OPENWEATHER_API_KEY=

# Embeddings / knowledge tooling
OLLAMA_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Price ingestion and cron protection
PRICES_CRON_SECRET=
CRON_SECRET=
PEST_CRON_SECRET=

# Weather alert trigger protection
ADVISOR_CRON_SECRET=

# Model API (vision disease detection). Point to your deployed apps/model-api
# service in production, e.g. https://<your-cloud-run-host>. Locally: http://127.0.0.1:8001
# When set, disease detection uses the trained vision model and needs NO LLM/HF keys.
MODEL_API_URL=http://127.0.0.1:8001

# Detect model (optional)
DETECT_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=linkanjarad/mobilenet_v2_1.0_224-plant-disease-identification

# Optional CACP projection service (falls back to local baselines)
CACP_API_URL=

# Optional app URL for generated links
NEXT_PUBLIC_APP_URL=http://localhost:3000
