__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/
artifacts/
data/cache/
/datasets/
*.egg-info/

# model_store/ is the slim, deployable inference bundle (19 MB). It is
# intentionally NOT ignored so container builds can COPY it without running the
# training pipeline. Regenerate with: nx run model-api:package-models
!model_store/
!model_store/**
